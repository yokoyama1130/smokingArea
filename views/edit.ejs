<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>編集画面</title>
</head>
<body>
    <h1>編集画面</h1>
    <form action="/areas/new" method="post">
        <div>
            <label for="name">名前</label>
            <input type="text" id="name" name="area[name]" value="<%= area.name %>">
        </div>
        <div>
            <label for="location">場所</label>
            <input type="text" id="location" name="area[location]" value="<%= area.location %>">
        </div>
        <button>登録</button>
    </form>
    
</body>
</html>