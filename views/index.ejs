<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>喫煙所一覧</title>
</head>
<body>
    <h1>喫煙所一覧画面</h1>
    <div>
        <a href="/areas/new">新規登録</a>
    </div>
    <ul>
        <% for (area of areas) { %>
            <li>
                <a href="/areas/<%= area._id %>"><%= area.name %></a>
            </li>
        <% } %>
    </ul>
</body>
</html>